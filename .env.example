# ScholarGuard AI Environment Configuration

# Server
PORT=8000
ENVIRONMENT=development

# Database (Default: SQLite for zero-configuration local execution)
DATABASE_URL=sqlite:///scholarguard.db
# PostgreSQL Option: postgresql://scholarguard:guardpass@localhost:5432/scholarguard_db

# External Scholarly APIs
CROSSREF_MAILTO=research@scholarguard.ai
OPENALEX_API_KEY=

# Model Configuration
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Storage Limits
MAX_UPLOAD_SIZE_MB=25
